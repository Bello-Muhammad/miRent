// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

model user {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  phone        String
  role         Role       @default(AGENT)
  image        String?
  publicId     String?
  resourceType String?
  status       String     @default("active")
  password     String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  properties   property[]
}

model property {
  id          String         @id @default(uuid())
  user        user           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String
  title       String
  description String?
  type        PropertyType
  amount      Decimal
  duration    Duration       @default(YEARLY)
  address     String
  area        String?
  city        String
  state       String
  country     String
  images      image[]
  status      PropertyStatus @default(AVAILABLE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model image {
  id           String   @id @default(uuid())
  url          String
  publicId     String
  resourceType String
  property     property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  ADMIN
  AGENT
}

enum PropertyType {
  FLAT
  DUPLEX
  SELF_CONTAINED
  SINGLE_ROOM
  MANSION
  PENT_HOUSE
  CONDO
  MINI_FLAT
}

enum PropertyStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum Duration {
  MONTHLY
  YEARLY
}
